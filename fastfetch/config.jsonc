{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/avatar.png",
        "type": "kitty",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 2,
            "left": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "cyan"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "font",
            "key": " ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
